# Credenciales de SharePoint (Azure AD App)
# Copia este archivo a .env y completa con tus credenciales reales

SHAREPOINT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SHAREPOINT_CLIENT_SECRET=tu_client_secret_aqui
SHAREPOINT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Las credenciales reales las obtienes desde Azure AD App Registration
